{
  "manifest_version": 3,
  "name": "BillNext - B站重构：全新首页、内容管理与自动追番",
  "short_name": "BillNext",
  "version": "2.0.0",
  "description": "重做 B 站首页与动态：自动追番抓取更新、聚合推荐与关注，一键想看、不想看。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://api.live.bilibili.com/*",
    "https://api.bgm.tv/*",
    "https://api.graphql.imdb.com/*",
    "https://v3.sg.media-imdb.com/*",
    "https://m.douban.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "imdb_api_headers",
        "enabled": true,
        "path": "rules/imdb-api-headers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/assets/fonts/*"
      ],
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "dist/content/content.js"
      ],
      "css": [
        "dist/content/style.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "dist/inject/index.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
